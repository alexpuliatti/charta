{
  "name": "charta-library",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A small, open source library for links, notes, and connected collections.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "sync:reader": "node scripts/sync-reader.mjs",
    "vendor:pdf": "node scripts/vendor-pdf.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs extension/tests/*.test.mjs",
    "test:local": "node scripts/smoke-local.mjs",
    "check": "node scripts/check.mjs",
    "build:components": "node scripts/build-components.mjs",
    "pretest": "npm run build:components"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "4.4.0",
    "@hugeicons/react": "1.1.10",
    "fflate": "^0.8.3",
    "jsdom": "29.1.1",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "unpdf": "^2.2.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
